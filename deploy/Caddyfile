pingvakt.exempel.se {
	encode gzip
	reverse_proxy pingvakt:8080 {
		flush_interval -1
	}
}

# Fjärrsidor: enheters webbsidor som öppnas via agenten (IP-adresser → HTTP/HTTPS).
# Egen port = eget ursprung, så att enhetens sidor inte kommer åt C4Pulse.
pingvakt.exempel.se:8443 {
	reverse_proxy pingvakt:8081 {
		flush_interval -1
	}
}
